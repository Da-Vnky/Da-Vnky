# keep the little shell scripts in unix line endings, even on windows
# (with windows line endings they quietly stop working)
*.sh            text eol=lf
tools/hooks/*   text eol=lf
*.bat           text eol=crlf

# the lists are written by tools/update-lists.sh, never by hand: when two people's changes come together
# (tools/pull.sh) they can't clash, they're just written again afterwards
list.txt                  merge=regen
catalog.txt               merge=regen
files.txt                 merge=regen
manifest.txt              merge=regen
assets/resets/index.txt   merge=regen
content/living/albums.txt merge=regen

# the change log: two people adding lines at once keep both (never a clash)
CHANGES.txt               merge=union
