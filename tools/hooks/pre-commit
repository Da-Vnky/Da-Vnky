#!/bin/sh
# before each commit: refresh every content/<scene>/list.txt and assets/<folder>/list.txt, and include them in the commit.
# turn it on once, from the top of the site:   git config core.hooksPath tools/hooks
root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0
# (tr strips windows line endings, in case they crept in)
tr -d '\r' < tools/update-lists.sh | sh
for f in "$root"/catalog.txt "$root"/manifest.txt "$root"/files.txt "$root"/content/*/list.txt "$root"/content/*/*/list.txt "$root"/assets/*/list.txt; do
    [ -f "$f" ] && git add "$f"
done
exit 0
