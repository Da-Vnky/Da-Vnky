# the letters manager's private post office: FormSubmit key and unread post. never published.
.inbox/

# your texture originals (the site uses the smaller copies in assets/textures/)
textures to use/
sfx to use/

# the content manager's debug page: only for your own computer, never published
tools/debug.html

# your own versions of files that were changed on Forgejo too, kept by tools/pull.sh until they're put together
_your-versions/

# the template pictures for your art program (tools/templates.py makes them again whenever you like)
tools/templates/

# python keeps compiled copies of the tools here when it runs them: never needed
__pycache__/

# the drawing table (tools/drawtable.py): your working files, exports and animation frames, and where your art programs
# are. they stay on your computer: what goes on the site is only what you put in a slot
tools/drawing/
